{
  "entities": {
    "Customer": {
      "title": "Customer",
      "description": "Customer profiles and contact details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "qrCodeData": { "type": "string" },
        "avatar": { "type": "string" },
        "createdAt": { "type": "string" },
        "passwordChanged": { "type": "boolean" },
        "password": { "type": "string" }
      },
      "required": ["id", "name", "phone", "email"]
    },
    "MeasurementRecord": {
      "title": "MeasurementRecord",
      "description": "Measurement profiles for customer Bespoke fittings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "clothingType": { "type": "string" },
        "date": { "type": "string" },
        "fields": { "type": "object" },
        "notes": { "type": "string" }
      },
      "required": ["id", "customerId", "clothingType", "date"]
    },
    "Worker": {
      "title": "Worker",
      "description": "Tailor shop work employees and credentials",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "rating": { "type": "number" },
        "baseSalary": { "type": "number" },
        "perOrderBonus": { "type": "number" },
        "avatar": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Order": {
      "title": "Order",
      "description": "Bespoke orders for clothing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "clothingType": { "type": "string" },
        "quantity": { "type": "number" },
        "deliveryDate": { "type": "string" },
        "status": { "type": "string" },
        "assignedWorkerId": { "type": "string" },
        "notes": { "type": "object" },
        "images": { "type": "object" },
        "price": { "type": "number" },
        "advancePayment": { "type": "number" },
        "remainingBalance": { "type": "number" },
        "paymentStatus": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "customerId", "clothingType", "quantity", "price", "status"]
    },
    "NotificationLog": {
      "title": "NotificationLog",
      "description": "System alerts and dispatch history logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "recipient": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "type", "recipient", "message", "timestamp"]
    },
    "RecentActivity": {
      "title": "RecentActivity",
      "description": "Owner and Staff security and audit trail",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" },
        "userRole": { "type": "string" },
        "userName": { "type": "string" }
      },
      "required": ["id", "action", "timestamp", "userName"]
    },
    "RegisteredTailor": {
      "title": "RegisteredTailor",
      "description": "Tailor shop workstations registered in the enterprise catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "password": { "type": "string" },
        "createdAt": { "type": "string" },
        "hasRegisteredShop": { "type": "boolean" },
        "shopName": { "type": "string" },
        "logoUrl": { "type": "string" },
        "coordinateLatitude": { "type": "string" },
        "coordinateLongitude": { "type": "string" }
      },
      "required": ["id", "name"]
    }
  },
  "firestore": {
    "customers": {
      "schema": "Customer",
      "description": "Central collection of customer profile documents"
    },
    "measurements": {
      "schema": "MeasurementRecord",
      "description": "Historical measurement logs by customer ID mapping"
    },
    "workers": {
      "schema": "Worker",
      "description": "Profiles for active and reserve workshop staff members"
    },
    "orders": {
      "schema": "Order",
      "description": "Workshop tailoring order lifecycles and payments database"
    },
    "notifications": {
      "schema": "NotificationLog",
      "description": "WhatsApp and Email notification dispatch history logs"
    },
    "activities": {
      "schema": "RecentActivity",
      "description": "Audit logging for staff and admin operations"
    },
    "registered_tailors": {
      "schema": "RegisteredTailor",
      "description": "Directory of registered workstations and storefronts in the system"
    }
  }
}
